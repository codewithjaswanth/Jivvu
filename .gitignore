# Virtual environments
.venv/
venv/
ENV/
env/

# Environment secrets & credentials (NEVER commit these)
backend/.env
backend/.env.*
!backend/.env.example
.env
.env.*
!.env.example
.env.local

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Evaluation output artifacts
eval/results/*.json
!eval/results/.gitkeep

# Runtime server logs, lockfiles & state
backend/server.log
backend/server.err.log
backend/supervisor.lock
runtime_state.json
backend/runtime_state.json
backend/native_host_silent.exe
*.log
backend/*.log

# Windows Native Host Manifests & Shortcuts (auto-generated per machine)
backend/com.quizzy.lifecycle.json
backend/com.quizzy.launcher.json
native_host/*.json
*.lnk

# Scratch & Debug artifacts
debug_*.js
clean_*.py
rebuild_*.py
task.md
.taste-skill/
scratch/cache_dump.json
scratch/telemetry_recent.json

# IDE, Editor, & OS metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

*.egg-info/
